# Copy to .env.development for local work, or .env for overrides.
# Nest loads: .env.[NODE_ENV].local → .env.[NODE_ENV] → .env.local → .env


DATABASE_URL=postgresql://postgres:admin123@localhost:5434/guitare_app?schema=public
# Optional direct, non-pooler URL used by Prisma migrations on hosted Postgres.
DIRECT_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_MAX=5
TRANSCRIPTION_DATABASE_TIMEOUT_MS=15000
PORT=3000
DEBUG=false
JWT_SECRET=dev-secret-change-me-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=fretflow_refresh
CORS_ORIGINS=http://localhost:5173
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flowfret.app
APP_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
EXTERNAL_HTTP_TIMEOUT_MS=15000
UPLOAD_MAX_STORAGE_BYTES_PER_USER=262144000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=fretflow
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MUSIC_PROVIDER=AUDIUS
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_DL_PYTHON_BIN=python3
# Optional Netscape-format cookie file, preferably mounted as a Render Secret File.
YOUTUBE_COOKIES_FILE=
# Optional bgutil-ytdlp-pot-provider HTTP server URL (see Dockerfile.worker/
# docker-compose.yml's pot-provider service). Reduces reliance on cookies.
YOUTUBE_POT_PROVIDER_URL=
YOUTUBE_AUDIO_MAX_SIZE_MB=30
YOUTUBE_AUDIO_MAX_DURATION_SECONDS=300
YOUTUBE_AUDIO_DOWNLOAD_TIMEOUT_MS=120000
YOUTUBE_AUDIO_MAX_CONCURRENT=2
AUDIUS_API_KEY=
AUDIUS_API_SECRET=
AUDIUS_ACCESS_TOKEN=
GENIUS_ACCESS_TOKEN=
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_CLIENT_NAME=FlowFret
LRCLIB_TIMEOUT_MS=5000
# Optional: last-resort lyrics fallback (after LRCLIB and Genius), used to
# find a real page to extract lyrics from. See AZURE_OPENAI_CHAT_DEPLOYMENT
# above — both are required together for this fallback to activate.
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

REDIS_HOST=localhost
REDIS_URL=
REDIS_PRIVATE_URL=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

WHISPER_PYTHON_BIN=python3
FFMPEG_BIN_DIR=
LLM_PROVIDER=whisper
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=whisper
AZURE_OPENAI_API_VERSION=2024-06-01
# Optional: a separate chat/completions deployment (NOT the whisper one above)
# on the same or another Azure OpenAI resource, used only as a last-resort
# lyrics fallback to extract (never generate) lyrics from a real fetched
# web page. Reuses AZURE_OPENAI_ENDPOINT/AZURE_OPENAI_API_KEY above.
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_API_VERSION=2024-08-01-preview
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENGINE_VERSION=1

TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_QUEUE_TIMEOUT_MS=10000
TRANSCRIPTION_ATTEMPTS=3
TRANSCRIPTION_TIMEOUT_MS=900000
TRANSCRIPTION_INITIAL_BUFFER_SECONDS=45
TRANSCRIPTION_MIN_AHEAD_SECONDS=20
TRANSCRIPTION_RESUME_AHEAD_SECONDS=35
TRANSCRIPTION_MAX_AUDIO_SIZE_MB=100
TRANSCRIPTION_MAX_DURATION_SECONDS=300
TRANSCRIPTION_MAX_QUEUE_DEPTH=50
TRANSCRIPTION_MAX_REDIRECTS=3
TRANSCRIPTION_DOWNLOAD_TIMEOUT_MS=120000
TRANSCRIPTION_ALLOWED_AUDIO_HOSTS=.audius.co,.audius.work,.audiuscontent.co,.theblueprint.xyz,.zeogrid.com,.staked.cloud,.altego.net
TRANSCRIPTION_TEMP_DIR=

UPLOAD_MAX_CONCURRENT_GLOBAL=4
UPLOAD_MAX_CONCURRENT_PER_USER=2

GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_FIELDS=300
GRAPHQL_MAX_ALIASES=30
GRAPHQL_MAX_COMPLEXITY=200
GRAPHQL_BODY_LIMIT_KB=64
COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
