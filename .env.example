# Copy to .env.development for local work, or .env for overrides.
# Nest loads: .env.[NODE_ENV].local → .env.[NODE_ENV] → .env.local → .env


DATABASE_URL=postgresql://postgres:admin123@localhost:5434/guitare_app?schema=public
# Optional direct, non-pooler URL used by Prisma migrations on hosted Postgres.
DIRECT_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_MAX=5
TRANSCRIPTION_DATABASE_TIMEOUT_MS=15000
PORT=3000
DEBUG=false
# Generate with: npm run generate-secret (minimum 32 characters in production)
JWT_SECRET=dev-secret-change-me-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=fretflow_refresh
# Comma-separated exact frontend origins. APP_URL is allowed automatically.
CORS_ORIGINS=http://localhost:5173
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@fretflow.app
APP_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=fretflow
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Active music search/player provider: YOUTUBE, AUDIUS or SPOTIFY.
# Defaults to AUDIUS when omitted.
MUSIC_PROVIDER=AUDIUS
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
AUDIUS_API_KEY=
AUDIUS_API_SECRET=
AUDIUS_ACCESS_TOKEN=
GENIUS_ACCESS_TOKEN=
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_CLIENT_NAME=FretFlow
LRCLIB_TIMEOUT_MS=5000

REDIS_HOST=localhost
# On Render, prefer the internal Key Value connection string:
REDIS_URL=
REDIS_PRIVATE_URL=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

WHISPER_PYTHON_BIN=python3
FFMPEG_BIN_DIR=
# Use "azure" for Azure OpenAI Whisper, or "whisper" for the local model.
LLM_PROVIDER=whisper
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=whisper
AZURE_OPENAI_API_VERSION=2024-06-01
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENGINE_VERSION=1

TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_QUEUE_TIMEOUT_MS=10000
TRANSCRIPTION_ATTEMPTS=3
TRANSCRIPTION_TIMEOUT_MS=900000
TRANSCRIPTION_INITIAL_BUFFER_SECONDS=45
TRANSCRIPTION_MIN_AHEAD_SECONDS=20
TRANSCRIPTION_RESUME_AHEAD_SECONDS=35
TRANSCRIPTION_MAX_AUDIO_SIZE_MB=100
TRANSCRIPTION_MAX_DURATION_SECONDS=900
TRANSCRIPTION_MAX_REDIRECTS=3
TRANSCRIPTION_DOWNLOAD_TIMEOUT_MS=120000
TRANSCRIPTION_ALLOWED_AUDIO_HOSTS=.audius.co,.audius.work,.audiuscontent.co,.theblueprint.xyz,.zeogrid.com,.staked.cloud
TRANSCRIPTION_TEMP_DIR=

UPLOAD_MAX_CONCURRENT_GLOBAL=4
UPLOAD_MAX_CONCURRENT_PER_USER=2
