generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum InstructorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TeachingCourseFormat {
  INDIVIDUAL
  GROUP
}

enum TeachingMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum TeachingCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TeachingPriceUnit {
  PER_COURSE
  PER_LESSON
}

enum TeachingEnrollmentStatus {
  REQUESTED
  INVITED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum PostStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
  BLOCKED
}

enum UploadStatus {
  UPLOADED
  PROCESSING
  AVAILABLE
  FAILED
  DELETED
}

enum UploadSourceType {
  POST
  PROFILE
  MESSAGE
  OTHER
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  COMMENT_CREATED
  POST_CREATED
  UPLOAD_READY
  SYSTEM
  FRIEND_POST
  POST_LIKE
  POST_COMMENT
  FOLLOWED_POST_ACTIVITY
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  RESOLVED
}

enum AttachmentKind {
  AUDIO
  IMAGE
  OTHER
}

enum TranscriptionStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  READY_TO_PLAY
  COMPLETED
  FAILED
}

enum MusicProvider {
  AUDIUS
  SPOTIFY
  YOUTUBE
}

enum PlaylistVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

model Transcription {
  id                String                @id @default(uuid()) @db.Uuid
  provider          MusicProvider         @default(AUDIUS)
  trackId           String                @map("track_id") @db.VarChar(255)
  title             String?               @db.VarChar(500)
  artist            String?               @db.VarChar(500)
  requestedLanguage String                @default("auto") @map("requested_language") @db.VarChar(16)
  detectedLanguage  String?               @map("detected_language") @db.VarChar(16)
  model             String                @db.VarChar(32)
  engineVersion     String                @map("engine_version") @db.VarChar(32)
  status            TranscriptionStatus   @default(PENDING)
  progress          Int                   @default(0)
  bufferedUntil     Float                 @default(0) @map("buffered_until")
  duration          Float?
  readyToPlay       Boolean               @default(false) @map("ready_to_play")
  segments          Json?                 @db.JsonB
  lrcContent        String?               @map("lrc_content") @db.Text
  errorCode         String?               @map("error_code") @db.VarChar(64)
  errorMessage      String?               @map("error_message") @db.Text
  attempts          Int                   @default(0)
  manualRetryCount  Int                   @default(0) @map("manual_retry_count")
  processingPhase   String?               @map("processing_phase") @db.VarChar(32)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(6)
  isDeleted         Boolean               @default(false) @map("is_deleted")
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(6)
  accessors         TranscriptionAccess[]

  @@unique([provider, trackId, requestedLanguage, model, engineVersion], map: "transcriptions_cache_key_unique")
  @@index([provider, trackId])
  @@index([status])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("transcriptions")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  email                 String     @unique @db.VarChar(255)
  passwordHash          String?    @map("password_hash") @db.VarChar(255)
  googleId              String?    @unique @map("google_id") @db.VarChar(255)
  googleSignupCompleted Boolean    @default(false) @map("google_signup_completed")
  username              String     @unique @db.VarChar(50)
  status                UserStatus @default(PENDING)
  role                  UserRole   @default(USER)
  lastLoginAt           DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted             Boolean    @default(false) @map("is_deleted")
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile                 Profile?
  instructorProfile       InstructorProfile?
  teachingEnrollments     TeachingEnrollment[]       @relation("TeachingEnrollmentStudent")
  authoredPosts           Post[]                   @relation("UserAuthoredPosts")
  comments                Comment[]                @relation("UserComments")
  uploads                 Upload[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]               @relation("UserAuditLogs")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  friendshipsRequested    Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived     Friendship[]             @relation("FriendshipReceiver")
  likes                   PostLike[]
  reports                 PostReport[]             @relation("PostReportsByReporter")
  postMentions            PostMention[]            @relation("UserPostMentions")
  commentMentions         CommentMention[]         @relation("UserCommentMentions")
  transcriptionAccess     TranscriptionAccess[]
  playlists               Playlist[]               @relation("UserPlaylists")
  playlistItemsAdded      PlaylistItem[]           @relation("PlaylistItemsAddedByUser")
  listeningHistory        ListeningHistory[]

  @@index([isDeleted, createdAt(sort: Desc)])
  @@index([isDeleted, status])
  @@map("users")
}

model ChordTranscription {
  id              String        @id @default(uuid()) @db.Uuid
  provider        MusicProvider
  providerTrackId String        @map("provider_track_id") @db.VarChar(255)
  title           String?       @db.VarChar(500)
  artist          String?       @db.VarChar(500)
  duration        Float
  cues            Json          @db.JsonB
  engineVersion   String        @map("engine_version") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerTrackId], map: "chord_transcriptions_provider_track_unique")
  @@index([provider, providerTrackId])
  @@map("chord_transcriptions")
}

model ListeningHistory {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        MusicProvider
  providerTrackId String        @map("provider_track_id") @db.VarChar(255)
  title           String        @db.VarChar(500)
  artists         Json          @db.JsonB
  imageUrl        String?       @map("image_url") @db.Text
  externalUrl     String        @map("external_url") @db.Text
  streamUrl       String        @map("stream_url") @db.Text
  album           String?       @db.VarChar(500)
  genre           String?       @db.VarChar(120)
  isrc            String?       @db.VarChar(32)
  durationMs      Int           @map("duration_ms")
  playCount       Int           @default(1) @map("play_count")
  lastPlayedAt    DateTime      @default(now()) @map("last_played_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerTrackId], map: "listening_history_user_provider_track_unique")
  @@index([userId, lastPlayedAt(sort: Desc)])
  @@map("listening_history")
}

model CatalogTrack {
  id              String         @id @default(uuid()) @db.Uuid
  provider        MusicProvider
  providerTrackId String         @map("provider_track_id") @db.VarChar(255)
  title           String         @db.VarChar(500)
  artists         Json           @db.JsonB
  album           String?        @db.VarChar(500)
  genre           String?        @db.VarChar(120)
  imageUrl        String?        @map("image_url") @db.Text
  externalUrl     String         @map("external_url") @db.Text
  durationMs      Int            @map("duration_ms")
  isrc            String?        @db.VarChar(32)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  playlistItems   PlaylistItem[]

  @@unique([provider, providerTrackId], map: "catalog_tracks_provider_track_unique")
  @@index([provider, title])
  @@index([genre])
  @@map("catalog_tracks")
}

model Playlist {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  name         String             @db.VarChar(120)
  description  String?            @db.Text
  coverUrl     String?            @map("cover_url") @db.Text
  visibility   PlaylistVisibility @default(PRIVATE)
  version      Int                @default(0)
  nextPosition Int                @default(0) @map("next_position")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted    Boolean            @default(false) @map("is_deleted")
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user  User           @relation("UserPlaylists", fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  addedById  String   @map("added_by_id") @db.Uuid
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  playlist Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    CatalogTrack @relation(fields: [trackId], references: [id], onDelete: Restrict)
  addedBy  User         @relation("PlaylistItemsAddedByUser", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([playlistId, trackId], map: "playlist_items_playlist_track_unique")
  @@unique([playlistId, position], map: "playlist_items_playlist_position_unique")
  @@index([trackId])
  @@index([addedById])
  @@map("playlist_items")
}

model TranscriptionAccess {
  userId          String   @map("user_id") @db.Uuid
  transcriptionId String   @map("transcription_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@id([userId, transcriptionId])
  @@index([transcriptionId])
  @@map("transcription_access")
}

model Profile {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  displayName String            @map("display_name") @db.VarChar(120)
  avatarUrl   String?           @map("avatar_url") @db.Text
  bio         String?           @db.Text
  location    String?           @db.VarChar(120)
  websiteUrl  String?           @map("website_url") @db.Text
  level       String?           @db.VarChar(50)
  visibility  ProfileVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility])
  @@map("profiles")
}

/// A teaching capability attached to a regular FlowFret account. A user may
/// also be enrolled as a student in other courses.
model InstructorProfile {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique @map("user_id") @db.Uuid
  status            InstructorStatus @default(PENDING)
  headline          String?          @db.VarChar(160)
  biography         String?          @db.Text
  experienceYears   Int?             @map("experience_years")
  specialties       String[]         @default([])
  languages         String[]         @default([])
  storageQuotaBytes BigInt           @default(0) @map("storage_quota_bytes") @db.BigInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted         Boolean          @default(false) @map("is_deleted")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  courses TeachingCourse[]

  @@index([status, isDeleted, createdAt(sort: Desc)])
  @@map("instructor_profiles")
}

/// A paid guitar course offered by an approved instructor. Capacity is
/// persisted now so group classes can be enabled without replacing this model.
model TeachingCourse {
  id                String               @id @default(uuid()) @db.Uuid
  instructorId      String               @map("instructor_id") @db.Uuid
  title             String               @db.VarChar(160)
  description       String?              @db.Text
  level             String?              @db.VarChar(50)
  format            TeachingCourseFormat @default(INDIVIDUAL)
  maxStudents       Int                  @default(1) @map("max_students")
  teachingMode      TeachingMode         @default(HYBRID) @map("teaching_mode")
  priceAmount       Int                  @map("price_amount")
  priceCurrency     String               @default("EUR") @map("price_currency") @db.VarChar(3)
  priceUnit         TeachingPriceUnit    @default(PER_COURSE) @map("price_unit")
  durationMinutes   Int                  @map("duration_minutes")
  status            TeachingCourseStatus @default(DRAFT)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted         Boolean              @default(false) @map("is_deleted")
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(6)

  instructor InstructorProfile     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  enrollments TeachingEnrollment[]

  @@index([instructorId, status, isDeleted, updatedAt(sort: Desc)])
  @@index([status, teachingMode, isDeleted, createdAt(sort: Desc)])
  @@map("teaching_courses")
}

/// Students must be existing FlowFret users. Keeping enrollment separate
/// supports invitations, requests, pauses and a future multi-student format.
model TeachingEnrollment {
  id          String                  @id @default(uuid()) @db.Uuid
  courseId    String                  @map("course_id") @db.Uuid
  studentId   String                  @map("student_id") @db.Uuid
  status      TeachingEnrollmentStatus @default(REQUESTED)
  invitedAt   DateTime?               @map("invited_at") @db.Timestamptz(6)
  acceptedAt  DateTime?               @map("accepted_at") @db.Timestamptz(6)
  endedAt     DateTime?               @map("ended_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted   Boolean                 @default(false) @map("is_deleted")
  deletedAt   DateTime?               @map("deleted_at") @db.Timestamptz(6)

  course  TeachingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student User           @relation("TeachingEnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId], map: "teaching_enrollments_course_student_unique")
  @@index([studentId, status, isDeleted, updatedAt(sort: Desc)])
  @@index([courseId, status, isDeleted, createdAt])
  @@map("teaching_enrollments")
}

model Post {
  id            String         @id @default(uuid()) @db.Uuid
  authorId      String         @map("author_id") @db.Uuid
  content       String?        @db.Text
  coverImageUrl String?        @map("cover_image_url") @db.Text
  audioUrl      String?        @map("audio_url") @db.Text
  visibility    PostVisibility @default(PUBLIC)
  likeCount     Int            @default(0) @map("like_count")
  commentCount  Int            @default(0) @map("comment_count")
  status        PostStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  isDeleted     Boolean        @default(false) @map("is_deleted")

  author      User             @relation("UserAuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       PostLike[]
  reports     PostReport[]
  attachments PostAttachment[]
  mentions    PostMention[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  content   String        @db.Text
  status    CommentStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  isDeleted Boolean       @default(false) @map("is_deleted")

  post     Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User             @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("comments")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  receiverId  String           @map("receiver_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId], map: "friendships_requester_receiver_unique")
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Upload {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  fileName        String           @map("file_name") @db.VarChar(255)
  fileType        String           @map("file_type") @db.VarChar(100)
  fileSize        BigInt           @map("file_size") @db.BigInt
  storagePath     String           @map("storage_path") @db.Text
  storagePublicId String?          @map("storage_public_id") @db.Text
  cleanupPending  Boolean          @default(false) @map("cleanup_pending")
  duration        Int?             @db.Integer
  status          UploadStatus     @default(UPLOADED)
  sourceType      UploadSourceType @default(OTHER) @map("source_type")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  isDeleted       Boolean          @default(false) @map("is_deleted")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments PostAttachment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([sourceType, createdAt(sort: Desc)])
  @@index([cleanupPending, isDeleted])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@map("uploads")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json             @db.JsonB
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted Boolean          @default(false) @map("is_deleted")
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type], map: "notification_preferences_user_type_unique")
  @@index([userId, enabled])
  @@map("notification_preferences")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String    @map("actor_id") @db.Uuid
  action     String    @db.VarChar(100)
  entityType String    @map("entity_type") @db.VarChar(100)
  entityId   String?   @map("entity_id") @db.Uuid
  metadata   Json      @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  actor User @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, isDeleted, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
