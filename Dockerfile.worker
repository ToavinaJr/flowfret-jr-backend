FROM oven/bun:1.4.4 AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build
RUN bun prune --production

FROM node:22-bookworm-slim
COPY --from=build /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY workers/transcription/requirements.txt /tmp/transcription-requirements.txt
COPY requirements.youtube.txt /tmp/youtube-requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages \
    -r /tmp/transcription-requirements.txt \
    -r /tmp/youtube-requirements.txt
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./prisma.config.ts
COPY --from=build /app/package.json ./
COPY workers ./workers
RUN mkdir -p /models /transcription-tmp && chown node:node /models /transcription-tmp
USER node
CMD ["bun", "run", "start:worker"]

